# ==========================================================
# MagicBody GEO/AEO Tracker — 환경 변수
# ==========================================================
# 로컬 개발: 이 파일을 .env.local 로 복사해 값 입력
# 서버 배포: /appdata/apps/geo-tracker/.env 로 복사해 값 입력
# ==========================================================

# ----- Bright Data (필수: AI 응답 수집 / SERP / Unlocker) -----
# https://brightdata.com → My Zones → API token
BRIGHT_DATA_KEY=

# Bright Data LLM Scrapers 데이터셋 ID (AI별)
# https://brightdata.com/cp/data_collectors 에서 각 스크래퍼의 Dataset ID 확인
BRIGHT_DATA_DATASET_CHATGPT=
BRIGHT_DATA_DATASET_PERPLEXITY=
BRIGHT_DATA_DATASET_COPILOT=
BRIGHT_DATA_DATASET_GEMINI=
BRIGHT_DATA_DATASET_GOOGLE_AI=
BRIGHT_DATA_DATASET_GROK=

# Bright Data Zone (선택: 기본값 사용 가능)
BRIGHT_DATA_SERP_ZONE=serp_n8n
BRIGHT_DATA_UNLOCKER_ZONE=web_unlocker1

# ----- OpenRouter (선택: AEO 감사 / SRO 분석 / 사이트 컨텍스트 자동 추출) -----
# https://openrouter.ai/keys
OPENROUTER_KEY=

# ----- Google Gemini (선택: Gemini Grounding 직접 호출용) -----
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ----- LLM provider 선택 (sentiment 분류기) -----
# openrouter = OpenRouter 통한 Claude (OPENROUTER_KEY 재활용, prompt caching 지원)
# claude     = Anthropic 직접 (별도 ANTHROPIC_API_KEY 발급 필요, 비용 최저)
# openai     = OpenAI gpt-4o-mini (기본, 한국어 정확도 약함)
LLM_PROVIDER=openai

# OpenRouter (LLM_PROVIDER=openrouter 시 사용 — OPENROUTER_KEY 위에서 재활용)
# 모델 ID는 https://openrouter.ai/models 에서 확인
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Anthropic 직접 (LLM_PROVIDER=claude 시 필수)
# https://console.anthropic.com/ → API Keys
ANTHROPIC_API_KEY=
# 기본 claude-haiku-4-5-20251001 (한국어 우수, 비용 적당)
# 더 정확한 판정 원하면 claude-sonnet-4-6 (비용 약 4배)
ANTHROPIC_API_MODEL=claude-haiku-4-5-20251001

# OpenAI (LLM_PROVIDER=openai 시 필수)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_API_MODEL=gpt-4o-mini

# ----- Next.js -----
NEXT_TELEMETRY_DISABLED=1

# ==========================================================
# 인증 (CMS 연동 + 최고관리자 자체 로그인)
# ==========================================================

# ----- Firebase Web SDK (CMS와 동일한 classnaom 프로젝트) -----
# 일반관리자 경로(/geo-tracker)에서 CMS 로그인 세션 감지용
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=classnaom.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=classnaom
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=classnaom.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ----- Firebase ID 토큰 검증 (서비스 계정 불필요) -----
# Google 공개키로 직접 검증 — 프로젝트 ID 만 있으면 됨
# NEXT_PUBLIC_FIREBASE_PROJECT_ID 와 자동 연동되나, 명시 지정도 가능
FIREBASE_PROJECT_ID=

# ----- CMS API 연동 (role 조회) -----
CMS_API_DOMAIN=https://api.magicbodypilates.co.kr
CMS_API_APP_ID=
CMS_API_APP_KEY=
CMS_LOGIN_URL=https://cms.magicbodypilates.co.kr/Account/Login

# ----- 최고관리자 자체 로그인 -----
# bcrypt 해시. `node -e "require('bcryptjs').hash('<비밀번호>',10).then(console.log)"` 로 생성
# 반드시 작은따옴표로 감쌀 것 ($ 는 env 변수 참조로 해석될 수 있음)
ADMIN_PASSWORD_HASH=''

# ----- 세션 쿠키 서명 시크릿 (32바이트 랜덤) -----
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=

# ----- 개발 중 CMS 검증 우회 -----
# true면 Firebase Admin/CMS API 호출 없이 아무 로그인도 통과. 배포 환경에선 false 또는 제거
DEV_AUTH_BYPASS=false
